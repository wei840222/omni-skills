    {
      "id": "t01",
      "public": {
        "request": "Implement an exported describe(result: Result): string for a discriminated success/failure result. Success returns \"value=\"+value; failure returns \"error=\"+message. Preserve the supplied public type and use real narrowing.",
        "artifact_contract": {
          "filename": "solution.ts",
          "interface": "export type Result = {ok:true,value:number}|{ok:false,message:string}; export function describe(result:Result):string",
          "constraints": "No imports, any, casts/type assertions, compiler suppression directives, filesystem or network APIs. Plain exported function declarations; no classes or decorators."
        },
        "input_data": {
          "examples": [
            {
              "input": {
                "ok": true,
                "value": 3
              },
              "output": "value=3"
            },
            {
              "input": {
                "ok": false,
                "message": "retry"
              },
              "output": "error=retry"
            }
          ]
        }
      },
      "grader": {
        "kind": "ts",
        "function": "describe",
        "ts_harness": "import {describe, type Result} from \"./solution\";\nconst a: string = describe({ok:true,value:2});\nconst b: string = describe({ok:false,message:\"x\"});\n// @ts-expect-error missing branch payload\ndescribe({ok:true});\n// @ts-expect-error wrong discriminator\ndescribe({ok:\"yes\",value:1});\n",
        "cases": [
          {
            "args": [
              {
                "ok": true,
                "value": 0
              }
            ],
            "expected": "value=0"
          },
          {
            "args": [
              {
                "ok": true,
                "value": -8
              }
            ],
            "expected": "value=-8"
          },
          {
            "args": [
              {
                "ok": false,
                "message": ""
              }
            ],
            "expected": "error="
          },
          {
            "args": [
              {
                "ok": false,
                "message": "line\nbreak"
              }
            ],
            "expected": "error=line\nbreak"
          }
        ]
      },
      "source_refs": [
        {
          "path": "skills/typescript/SKILL.md",
          "line_start": 3,
          "line_end": 3,
          "sha256": "9230a9b19f9d26f3b872aa22bd67f522b7f4ee39b2778d4918d0e11e2017a84c"
        }
